{
  "mcpServers": {
    "pencil": {
      "command": "C:\\Program Files\\Pencil\\resources\\app.asar.unpacked\\out\\mcp-server-windows-x64.exe",
      "args": [
        "--app",
        "desktop"
      ],
      "env": {}
    },
    "chrome-devtools": {
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "command": "npx"
    },
    "context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "command": "npx"
    },
    "filesystem": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        ""
      ],
      "command": "npx",
      "disabled": true
    },
    "github": {
      "args": [
        "/c",
        "D:\\frank\\windsurf-dao\\mcp\\github-mcp.cmd"
      ],
      "command": "cmd",
      "disabled": true
    },
    "memory": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "command": "npx",
      "disabled": true,
      "env": {
        "MEMORY_FILE_PATH": "C:\\frank\\memory.json"
      }
    },
    "playwright": {
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--browser",
        "chromium"
      ],
      "command": "npx",
      "disabled": true,
      "env": {
        "HTTPS_PROXY": "http://127.0.0.1:7890",
        "HTTP_PROXY": "http://127.0.0.1:7890"
      }
    }
  }
}