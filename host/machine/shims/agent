#!/bin/sh
# agent shim (Git Bash): same Clash Party proxy as cursor-agent
# proxy: set DAO_PROXY to override (default keeps legacy 7890 behavior)
: "${DAO_PROXY:=http://127.0.0.1:7890}"
export HTTPS_PROXY="$DAO_PROXY" HTTP_PROXY="$DAO_PROXY" ALL_PROXY="$DAO_PROXY"
export NODE_USE_ENV_PROXY=1
exec "${LOCALAPPDATA}/cursor-agent/agent.cmd" "$@"
