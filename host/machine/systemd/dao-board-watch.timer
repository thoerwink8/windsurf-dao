# /etc/systemd/system/dao-board-watch.timer
#
# 20 分钟一轮。墙钟闸是 4 小时，扫得比这快意义不大；挂 :19 分（19/39/59）：
# 已占的 20 分钟档：commander-act 11/31/51、progress-watch 13/33/53、
# nudge-stalled 17/37/57。其余整点档：sync :1/5、miraquota :4/10、board-gc :07、
# land :17、patrol/close-issues :23、refiner :41。:19/20 都不撞。
# 装法见同目录 dao-board-watch.service 文件头。
#
# OnCalendar 是必需的，不是冗余：只有 OnBootSec/OnUnitActiveSec
# 这种单调时钟的 timer，停掉再起会进 active (elapsed) 死态，NEXT 显示 n/a。
# tests/timer-armed.test.js 守着这条。

[Unit]
Description=每 20 分钟扫一轮看板阶段超时（#818）

[Timer]
OnCalendar=*:19/20
OnBootSec=5min
OnUnitActiveSec=20min
Persistent=true

[Install]
WantedBy=timers.target
