# /etc/systemd/system/dao-agent-stall.timer
#
# 15 分钟量级 + 连红 2 轮（#833 消歧：不许求快；一次抖动不是事故）。
# 装法见同目录 dao-agent-stall.service 文件头。
#
# OnCalendar 是必需的，不是冗余：2026-09-05 实咬——只有 OnBootSec/OnUnitActiveSec 这种单调时钟
# 的 timer，停掉再起之后会进 active (elapsed) 死态，Trigger 显示 n/a 但状态仍是 active+enabled，
# systemctl 看上去一切正常，而它从 12:37 起就再没跑过，#833 的自动换人整段无声停摆。
# 挂一个墙钟点位，永远有下一次，这个死态就不存在。dao-check 的 timer-armed 判据守着它。

[Unit]
Description=每 15 分钟扫一轮 agent 终端屏面（#833）

[Timer]
OnCalendar=*:2/15
OnBootSec=3min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
