# /etc/systemd/system/dao-progress-watch.timer
#
# 20 分钟一轮。为什么是 20 不是更快：判据要连续 N=5 轮同一对象同一状态，
# 原料是 commander-act 每 20 分钟写一份 situation-*.json——扫得比写快只会
# 一遍遍读同一份没变的快照。挂 :13 分：dao-sync(:1/5)、
# dao-board-gc(:07)、commander-act(:11/20)、dao-patrol(:23) 都不撞。
# 装法见同目录 dao-progress-watch.service 文件头。
#
# OnCalendar 是必需的，不是冗余：2026-09-05 实咬——只有 OnBootSec/OnUnitActiveSec
# 这种单调时钟的 timer，停掉再起会进 active (elapsed) 死态，NEXT 显示 n/a 但状态
# 仍是 active+enabled，systemctl 看上去一切正常，而它再也不会触发，且没有任何
# 东西报警。挂一个墙钟点位，永远有下一次。tests/timer-armed.test.js 守着这条。

[Unit]
Description=每 20 分钟扫一轮盘面推进量（#1004）

[Timer]
OnCalendar=*:13/20
OnBootSec=4min
OnUnitActiveSec=20min
Persistent=true

[Install]
WantedBy=timers.target
