# /etc/systemd/system/dao-refiner.timer
#
# 一小时一轮。为什么是一小时：
#   · 更快没意义——新开的单晚进队几十分钟，没有人因此做错事。
#   · 更慢会让「没消歧」的盘面积一整天，帅位又得手工扫（本单起因就是 23 张开着、可派 0）。
#   · 每轮代价：1 次 issue list + 候选各 1 次 issue view 评论。量级跟关单定时器同级。
#
# 挂在 :41 分：dao-sync :01/:06…、dao-board-gc :07、dao-agent-stall :02/:17/:32/:47、
# dao-close-issues :23、commander-act :16/:36/:56、gw-remote-probe :18/:48。:41 谁也不撞。
#
# OnCalendar 是必需的：只有单调时钟的 timer 停掉再起会进 active(elapsed) 死态，
# NEXT 显示 n/a 但状态仍是 active+enabled，无人报警（2026-09-05 实咬）。
# tests/timer-armed.test.js 扫本目录每一个 .timer。
#
# Persistent=true：机器关过一段时间，开机后补跑一轮。
#
# 装法见同目录 dao-refiner.service 文件头。

[Unit]
Description=每小时给还没消歧的单跑一轮

[Timer]
OnCalendar=*:41:00
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
