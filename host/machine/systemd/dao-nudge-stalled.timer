# /etc/systemd/system/dao-nudge-stalled.timer
#
# 20 分钟一轮，挂 :17 分。现有点位：dao-sync(:1/5)、dao-board-gc(:07)、
# commander-act(:11/20)、dao-progress-watch(:13/20)、dao-patrol(:23)——:17 都不撞。
#
# 为什么是 20 分钟：mirasim 自己判卡死的阈值是 30 分钟，本单元只对已经落成
# `runState: incomplete` 的会话动手，扫得再快也没有更早的东西可看。
#
# OnCalendar 是必需的，不是冗余（判例见 dao-progress-watch.timer 文件头，2026-09-05 实咬）：
# 只有 OnBootSec/OnUnitActiveSec 的 timer，停掉再起会进 active (elapsed) 死态，
# NEXT 显示 n/a、状态却仍是 active+enabled，看上去一切正常而它再也不会触发。
# 这条今天又咬了一次：commander-act.timer 21:49 被停掉后整整 40 分钟没人发现
# （它有 OnCalendar，所以 start 一下就活了；没有的那种要重装）。
# tests/timer-armed.test.js 守着这条。

[Unit]
Description=每 20 分钟推一把卡住的会话（垫片，随 #1056 退役）

[Timer]
OnCalendar=*:17/20
OnBootSec=5min
OnUnitActiveSec=20min
Persistent=true

[Install]
WantedBy=timers.target
