# /etc/systemd/system/dao-nudge-stalled.service
#
# **垫片，随 issue #1056（对账循环）合并时整套退役。** 装它是因为无人值守时这条链是断的：
# 卡死查得出来（dao-progress-watch 每 20 分钟扫盘面推进量），但**没有任何东西去处置**——
# progress-watch 只叫醒帅位，帅位不在就一整夜没人动手。
#
# 正路做不到「往旧会话说话」：interact 只答会话里等着的问题，塞不进等下一轮的嘴里，
# 所以本垫片只能起新会话。闸的意思是：**人退了才起新的**；已关 issue / 已合 PR /
# 人还在（租约 held）/ 树不在该单 PR head 上，一律不推。
# 2026-09-07 实锤：没这三道闸时一次推了 6 棵（含已关 #1012/#1007、停在 master 的 #1063）。
# 判据在 scripts/lib/nudge-stalled.mjs。#1056 对账循环合并时本垫片整套退役。 本单元只跑垫片，不起会话的决策不在这里。
#
# 与 dao-progress-watch 的分工，别合并：
#   progress-watch  看**盘面对象**（PR / issue / 复审票）连续几轮没推进 → 叫醒帅位
#   本单元          看**会话**（mirasim 的 record.json）跑完一轮在等话 → 直接推一句
# 前者看不见「某个会话在等话」，后者看不见「这张 PR 三小时没人碰」。两个面互补。
#
# 装（服务器，orca 用户）：
#   sudo bash scripts/install-nudge-stalled.sh
#   systemctl list-timers | grep dao-nudge-stalled   # NEXT 不能是 `-`
#
# 退役：#1056 落地后，删本单元 + 删 scripts/nudge-stalled.mjs 和 scripts/lib/nudge-stalled.mjs。那张单正文里已登记。

[Unit]
Description=windsurf-dao nudge stalled sessions (垫片，随 #1056 退役)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=orca
WorkingDirectory=/srv/projects/windsurf-dao
Environment=PATH=/home/orca/.local/bin:/home/orca/bin:/usr/local/bin:/usr/bin:/bin
Environment=NO_COLOR=1
Environment=GH_NO_COLOR=1
# #792：自动化服务不继承个人 GH_TOKEN。
UnsetEnvironment=GH_TOKEN GITHUB_TOKEN
# #792：token 卸了，~/.config/gh 的个人登录还能用。指向空目录，gh 找不到 hosts.yml。
Environment=GH_CONFIG_DIR=/var/empty
ExecStart=/usr/bin/node /srv/projects/windsurf-dao/scripts/nudge-stalled.mjs --go
# 退出码 2 = 没查成（会话档案读不了 / PR 列表截断 / 闸面没查成）。
# 退出码 1 = 起会话失败（mirasim unavailable / 契约 / 上游拒绝，不是 busy）。
# busy 背压是 skip、exit 0。故意留成失败的，要在 systemctl --failed 里看得见，
# 不许跟「没有卡住的 / 全跳过 / 推成功」长成一个样。
StandardOutput=journal
StandardError=journal
