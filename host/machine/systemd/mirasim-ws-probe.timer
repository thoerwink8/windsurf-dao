# /etc/systemd/system/mirasim-ws-probe.timer
#
# 每 10 分钟探一轮 mirasim-server 的 ws 起会话面（#1151）。
# 10 不是随便挑的：握手只要几秒，再疏就会把「静默瘫痪一晚」再演一遍；
# 连红两轮才报警/自愈，最坏发现窗口约 20 分钟。
# 挂 :08 分：dao-sync(:1/5)、miraquota(:4/10)、dao-board-gc(:07)、
# gw-remote-probe(:09/30)、commander-act(:11/20)、dao-land(:17)、
# dao-close-issues(:23)、dao-refiner(:41) 都不撞。
# 装法见同目录 mirasim-ws-probe.service 文件头。
#
# OnCalendar 是必需的，不是冗余：只有 OnBootSec/OnUnitActiveSec 这种单调时钟
# 的 timer，停掉再起会进 active (elapsed) 死态，NEXT 显示 n/a 但状态仍是
# active+enabled，而它再也不会触发，且没有任何东西报警（2026-09-05 实咬）。
# tests/timer-armed.test.js 守着这条。

[Unit]
Description=每 10 分钟探一轮 mirasim-server ws 起会话面

[Timer]
OnCalendar=*:08/10
OnBootSec=2min
OnUnitActiveSec=10min
Persistent=true

[Install]
WantedBy=timers.target
