# /etc/systemd/system/dao-repo-hygiene.timer
#
# 每天一轮（10:23）——漂移是按天积累的，不是按分钟；跑得比 dao-sync 勤没有意义。
# 挂 :23 错开其它钟（skills-heal :03/5、board-watch :19、land :17、sync :01/5）。
#
# OnCalendar 是必需的——只有单调时钟的 timer 停掉再起会进 active(elapsed) 死态（timer-armed 闸守着）。
# 装法见同目录 dao-repo-hygiene.service 文件头。

[Unit]
Description=每天一轮仓库卫生巡检（未推/未拉 + PR 积压）

[Timer]
OnCalendar=*-*-* 10:23:00
OnBootSec=15min
Persistent=true

[Install]
WantedBy=timers.target
