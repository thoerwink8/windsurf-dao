# /etc/systemd/system/feishu-triage.service
#
# 飞书适配器 块A（issue #801 Phase 2）：长连接常驻，群消息 → triage → 建单。
#
# 装（服务器，orca 用户）：
#   # 1) SDK 依赖（live 长连接才要；测试/CI 不装。装一次即可）
#   cd /srv/projects/windsurf-dao/host/machine/feishu-triage && npm install --omit=dev
#   # 2) 单元
#   sudo install -m 644 host/machine/systemd/feishu-triage.service /etc/systemd/system/
#   # 3) 网关（补充2：与 claude 同一网关，OpenAI 兼容路径）。llm 网关来自 ANTHROPIC_BASE_URL，
#   #    由 EnvironmentFile 注入（实咬：不注入 llm 不可用，只回兜底话，日志一片安静）
#   sudo install -m 644 /home/orca/.config/ai-gateway/claude.env /etc/feishu-triage.env  # 若文件可被非 root 读
#   # 4) 起
#   sudo systemctl daemon-reload && sudo systemctl enable --now feishu-triage.service
#   journalctl -u feishu-triage.service -f
#
# 凭据：~/.mirasim/keys/feishu-app.json（600，不进 git，换机手动带）——
#   含 appId、appSecret、hubChatId、allowOpenIds 四项（appSecret 是飞书 App 的 secret）
# 状态：~/.dao/feishu-threads.json（话题状态，运行时自建，可丢可重算）
# 群映射：/srv/projects/windsurf-dao/host/machine/feishu-groups.json
#
# 行为：Restart=always —— kill -9 后 systemd 自动拉起（#801 验收 1）。
# 正常 `systemctl stop` 不会重启（显式停止不算失败）。

[Unit]
Description=Feishu triage adapter (long connection, issue #801)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=orca
# 帅 2026-09-03 实况：llm 网关来自 ANTHROPIC_BASE_URL（补充2），不注入 llm 只回兜底话。
# 服务器上把 claude 的 env 拷到 /etc/feishu-triage.env（600 root:root，systemd 以 root 读）
# 两份，缺一不炸（前缀 -）：
#  · public 那份 644，只放**不是密钥**的接线值（ANTHROPIC_BASE_URL / FEISHU_LLM_MODEL），
#    好让以 orca 身份跑的 server-check ⑰ 读得到「机器人在用哪个网关、哪个模型」——
#    2026-09-04 实咬：模型被砍后机器人哑了一整天，零报警，就是因为没人看得见这两个值。
#  · 另一份 600 root:root，放 ANTHROPIC_AUTH_TOKEN 等密钥，谁都别改成 644。
EnvironmentFile=-/etc/feishu-triage.public.env
EnvironmentFile=/etc/feishu-triage.env
WorkingDirectory=/srv/projects/windsurf-dao
ExecStart=/usr/bin/node /srv/projects/windsurf-dao/scripts/feishu-triage.mjs
Restart=always
RestartSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
