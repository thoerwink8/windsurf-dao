# /etc/systemd/system/gw-remote-probe.timer
#
# 每 30 分钟探一轮供应商健康。30 不是随便挑的：一轮串行探约 1 分钟，
# 再密会把 pqapi 这类排队上游自己挤慢（并行探过，sol 超时、串行 28s 就通）。
# 挂 :09 分：dao-sync(:1/5)、miraquota(:4/10)、dao-board-gc(:07)、
# dao-progress-watch(:13/20)、commander-act(:11/20)、dao-nudge(:17/20)、
# dao-close-issues(:23)、dao-refiner(:41) 都不撞。
# 装法见同目录 gw-remote-probe.service 文件头。
#
# OnCalendar 是必需的，不是冗余：2026-09-05 实咬——本 timer 长期只有
# OnBootSec/OnUnitActiveSec 这种单调时钟，停掉再起会进 active (elapsed)
# 死态，NEXT 显示 n/a 但状态仍是 active+enabled，systemctl 看上去一切正常，
# 而它再也不会触发，且没有任何东西报警。它写 ~/.dao/provider-health.json，
# 派工读它判可用性；停摆后派工把过期健康表当 unknown 不拦。
# 挂一个墙钟点位，永远有下一次。tests/timer-armed.test.js 守着这条。

[Unit]
Description=每 30 分钟探一轮供应商健康

[Timer]
OnCalendar=*:09/30
OnBootSec=5min
OnUnitActiveSec=30min
Persistent=true

[Install]
WantedBy=timers.target
