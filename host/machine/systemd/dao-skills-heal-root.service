# /etc/systemd/system/dao-skills-heal-root.service
#
# 为什么需要第二只钟（2026-09-13 实咬）：`dao-skills-heal.service` 跑在 `User=orca`，
# 修得住它够得着的家（通常 `/home/orca/.claude/skills`）；而 `dao-check` 是 root
# 跑的会话，看的是 `/root/.claude/skills`。两个 home 各自都「对」，合起来没人管——
# root 那份被 mirasim 劫成整目录链接后红了三天，自愈钟每 5 分钟对 orca 那份说「无事可做」。
#
# 归属为什么不能只留 orca 那只：`host/machine/INDEX.md` A 类把 `~/.claude/skills`
# 定成本仓的活。root 家 700，第三个用户的家 orca 也常够不着，只能以 root 枚举并修
# **本机每个有 `.claude/` 的家**（passwd 清单，不写死用户名、不钉 DAO_SKILL_HOMES）。
# 只有 `.mirasim/` 的家不纳入。
#
# 以 root 解释仓内脚本的安全前提，与 dao-execution-usage-export 同一条：
# 跑的是**安装到 root 自有目录的副本**，不是仓内可写的那份——否则每个能写仓的
# 执行体都拿到一条 root 通道。安装走 scripts/install-skills-heal.sh。
#
# 装法：sudo bash scripts/install-skills-heal.sh（与 orca 那只同一个脚本）
# 验：systemctl list-timers 里 dao-skills-heal-root.timer 的 NEXT 必须是时间；
#     dao-check ㉚ 对每个有 .claude/ 的家都绿。

[Unit]
Description=windsurf-dao skills 装载面自愈（root 枚举本机每个有 .claude/ 的家，#1146）
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=HOME=/root
# 不要钉 DAO_SKILL_HOMES=/root：钉死就扫不到第三个家。枚举走 skill-homes.mjs（passwd + HOME）。
# 跑的是 /usr/local 下的副本，从副本位置推不出仓在哪——仓根由单元写死在这里。
# 换仓目录要一并改（scripts/install-skills-heal.sh 会按实际路径重写这一行）。
Environment=DAO_REPO_ROOT=/srv/projects/windsurf-dao
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# 以 root 跑就顺手把凭据面全摘掉：本单元只建目录与符号链接，一个凭据都用不上。
UnsetEnvironment=GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN OPENAI_API_KEY ANTHROPIC_API_KEY XAI_API_KEY CURSOR_API_KEY DEVIN_API_KEY WINDSURF_API_KEY
Environment=GH_CONFIG_DIR=/var/empty
ExecStart=/usr/bin/node /usr/local/lib/dao-skills-heal/skills-heal.mjs
# 退出码 2 = 没查成，故意留成失败，不许跟「查过没事」长成一个样。
SuccessExitStatus=0
ProtectSystem=strict
ProtectHome=read-only
# /home 整棵可写：第三个用户的家不在 /root/.claude 下；脚本硬范围仍是 <家>/.claude/skills。
ReadWritePaths=/root/.claude /home
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
