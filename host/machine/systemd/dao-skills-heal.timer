# /etc/systemd/system/dao-skills-heal.timer
#
# 每 5 分钟一轮。mirasim 随时可能把装载面劫走，自愈必须比「人想起来手工重链」勤。
# 脚本幂等且无事可做时瞬间 exit 0，频率不是负担。
#
# 挂 *:03/5：错开 dao-sync（*:1/5）、board-gc（:07）、land（:17）。
# OnCalendar 是必需的——只有单调时钟的 timer 停掉再起会进 active(elapsed) 死态
# （2026-09-05 dao-agent-stall 实咬，timer-armed 闸守着）。
# 装法见同目录 dao-skills-heal.service 文件头。

[Unit]
Description=每 5 分钟把 ~/.claude/skills 从 mirasim 形态接回仓内

[Timer]
OnCalendar=*:03/5
OnBootSec=1min
Persistent=true

[Install]
WantedBy=timers.target
