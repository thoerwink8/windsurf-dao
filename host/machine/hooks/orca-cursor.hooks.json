{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "conhost.exe --headless cmd.exe /c \"%USERPROFILE%/.orca/agent-hooks/orca-cursor-hook.cmd\""
      }
    ],
    "stop": [
      {
        "command": "conhost.exe --headless cmd.exe /c \"%USERPROFILE%/.orca/agent-hooks/orca-cursor-hook.cmd\""
      }
    ]
  }
}
