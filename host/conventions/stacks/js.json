{
  "stack": "js",
  "_note": "按栈的机械项基线：默认继承（子仓默认就该有），可豁免——豁免写进子仓的 `## 豁免` 段并给理由。命令的前提是工具已装好，装法不进这里（那是子仓自己的事）。",
  "checks": [
    {
      "id": "syntax",
      "what": "改动文件的语法闸",
      "run": "node --check <改动文件>",
      "why": "零依赖、最快，语法错别留到审查"
    },
    {
      "id": "format",
      "what": "格式化检查",
      "run": "npx prettier --check .",
      "why": "风格不靠人记；能自动修的走自动修入口"
    },
    {
      "id": "lint",
      "what": "静态检查",
      "run": "npx eslint .",
      "why": "机械可判的问题别留给审查者（审查留给语义）"
    },
    {
      "id": "test",
      "what": "单元测试",
      "run": "node --test",
      "why": "默认不出网；要出网的项单独一档、按需跑"
    }
  ]
}
