{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dao-ui-mockup · selector-mapping",
  "description": "mockup HTML 与 impl dev server 的 selector 对应表 · 第六步固第 4 个产出 · 喂给 6.2 verify-visual.mjs",
  "type": "object",
  "required": ["meta", "scopes"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["topic", "direction", "mockupHtml", "implUrl"],
      "properties": {
        "topic": { "type": "string", "description": "如 'traceyu-theme-v0.2'" },
        "direction": { "type": "string", "description": "用户在第五步择选定的方向（如 'linear'）" },
        "createdAt": { "type": "string", "format": "date-time" },
        "mockupHtml": { "type": "string", "description": "相对路径，如 '_tmp/ui-mockup-<topic>-<ts>.html'" },
        "implUrl": { "type": "string", "description": "dev server URL，如 'http://localhost:1420'" },
        "viewport": {
          "type": "object",
          "properties": {
            "width": { "type": "integer", "default": 1280 },
            "height": { "type": "integer", "default": 800 }
          }
        }
      }
    },
    "scopes": {
      "type": "object",
      "description": "按页面/场景分组的 checks",
      "additionalProperties": {
        "type": "object",
        "required": ["checks"],
        "properties": {
          "openBy": {
            "type": "object",
            "description": "如何进入该 scope（如打开 dialog）",
            "properties": {
              "navigate": { "type": "string", "description": "URL path，如 '/projects/123'" },
              "click": { "type": "string", "description": "playwright selector，如 'button[aria-label=\"LLM 设置\"]'" },
              "wait": { "type": "integer", "description": "等待 ms" }
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "mockSel", "implSel"],
              "properties": {
                "name": { "type": "string", "description": "组件名，如 'btn-primary'" },
                "mockSel": { "type": "string", "description": "mockup HTML selector" },
                "implSel": { "type": "string", "description": "impl 端 selector（优先用 [data-slot=\"...\"]）" },
                "notes": { "type": "string", "description": "上下文说明 / 已知体系差异" },
                "skipDims": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["fontSize", "fontFamily", "fontWeight", "lineHeight", "color", "backgroundColor", "borderRadius", "borderWidth", "padding", "height"] },
                  "description": "已接受的体系差异维度（如 spacing 体系不同则 skip padding/height）"
                }
              }
            }
          }
        }
      }
    }
  }
}
