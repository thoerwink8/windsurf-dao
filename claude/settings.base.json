{
  "env": {
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Workflow",
      "NotebookEdit"
    ],
    "deny": [],
    "defaultMode": "default",
    "additionalDirectories": [
      "C:\\Users\\Administrator\\.claude"
    ]
  },
  "model": "claude-opus-4-8",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/frank/windsurf-dao/claude/hooks/dao-glob-gate.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/frank/windsurf-dao/claude/hooks/dao-cn-title.js\"",
            "timeout": 12
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/frank/windsurf-dao/claude/hooks/dao-settings-sync.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": false
  },
  "theme": "dark-ansi",
  "enableWorkflows": true,
  "includeCoAuthoredBy": false,
  "outputStyle": "dao-field"
}
