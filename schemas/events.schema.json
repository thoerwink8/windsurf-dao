{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "点将台事件账 schema（唯一权威）",
  "version": 1,
  "description": "事件类型闭集的唯一权威（设计 docs/dianjiangtai-design.md A.1）。加类型先改本文件：在 oneOf 里加一条带 title 的定义；只加字段不改语义翻转；读端容忍未知字段（additionalProperties: true）。事件类型闭集 = oneOf[].title，是它的派生枚举，任何实现不得另抄清单。派生镜子只能是注释（scripts/event-write.mjs 头注的 [闭集镜子] 段），改本文件必须同步它；对不上由 tests/session-events.test.js 报红。公共字段：ts（ISO8601 带时区）/ machine（机器名）/ seq（本机单调计数）/ event_id（内容哈希，写入时计算）/ schema_version。全序排序键 = (ts, machine, seq, event_id) 字典序（A.2）。",
  "definitions": {
    "base": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "schema_version": { "type": "integer", "const": 1 },
        "ts": { "type": "string", "description": "ISO8601 带时区，如 2026-08-15T10:00:00+08:00" },
        "machine": { "type": "string", "description": "机器名（文件名 <ulid>-<machine>.json 的 machine）" },
        "seq": { "type": "integer", "minimum": 0, "description": "本机单调计数器" },
        "event_id": { "type": "string", "description": "内容哈希（sha256 hex），写入时由脚本计算，不含本字段" }
      },
      "required": ["type", "schema_version", "ts", "machine", "seq", "event_id"],
      "additionalProperties": true
    },
    "attribution": {
      "type": "object",
      "description": "责任向量（D.1）。不变量：四份额和为 1；四份额全 0 是唯一合法例外（= 待定 unknown，须 confidence < 0.8）。overrun_attr 独立于失败责任向量。",
      "properties": {
        "job_id": { "type": "string" },
        "model": { "type": "string", "description": "可选：默认取该 job 的派单模型；L0 规则 6/7 换模型场景用它指向源模型" },
        "model_share": { "type": "number", "minimum": 0, "maximum": 1 },
        "brief_share": { "type": "number", "minimum": 0, "maximum": 1 },
        "coord_share": { "type": "number", "minimum": 0, "maximum": 1 },
        "env_share": { "type": "number", "minimum": 0, "maximum": 1 },
        "overrun_attr": { "enum": ["model", "brief", "coord", "env", null] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "type": "string" }, "description": "引用的事件 event_id 列表（L0 输出必须引用用过的事件 id）" },
        "why": { "type": "string", "description": "人读说明，算法永不读" }
      },
      "required": ["job_id", "model_share", "brief_share", "coord_share", "env_share", "overrun_attr", "confidence", "evidence", "why"],
      "additionalProperties": true
    }
  },
  "oneOf": [
    {
      "title": "job.opened",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "任务卡快照 + 候选 + 选中 + 解释串",
          "properties": {
            "type": { "const": "job.opened" },
            "job_id": { "type": "string" },
            "task_class": { "type": "string" },
            "work_type": { "type": "string", "description": "写码/判断/查证/审查/UI/…，可增枚举" },
            "identity": { "enum": ["帅", "协调者", "工人", "审官"] },
            "scale": { "type": "string" },
            "risk": { "enum": ["低", "中", "高"] },
            "reversible": { "type": "boolean" },
            "task_tokens": { "type": ["integer", "null"], "description": "任务预算 token（F14 门闩用）" },
            "candidate_models": { "type": "array", "items": { "type": "string" } },
            "selected": { "type": "string" },
            "why": { "type": "string" }
          },
          "required": ["job_id", "task_class", "work_type", "identity", "scale", "risk", "reversible", "task_tokens", "candidate_models", "selected", "why"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "job.dispatch",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "实际启动模型 + 终端 + 价目快照 + decision_id（E.1 决策票）",
          "properties": {
            "type": { "const": "job.dispatch" },
            "job_id": { "type": "string" },
            "model": { "type": "string" },
            "identity": { "enum": ["帅", "协调者", "工人", "审官"] },
            "work_type": { "type": "string" },
            "model_version": { "type": "string", "description": "派单时该模型版本串（F7 版本折扣）" },
            "terminal": { "type": "string" },
            "price_snapshot": { "type": "object", "description": "派单时刻价目快照（B.2 现算依据）" },
            "decision_id": { "type": "string", "description": "选型脚本输出的决策票（特征快照哈希，可复算）" },
            "split": { "description": "派工 --split 取值：no 或 ≥2 的整数（#611）" },
            "split_reason": { "type": ["string", "null"], "description": "--split no 的理由；N 时可空（#611）" },
            "merge_policy": { "enum": ["auto", "manual"], "description": "派工 merge-policy（#799：审官 create/attach 继承）" },
            "merge_reason": { "type": ["string", "null"], "description": "merge-policy=manual 的理由" }
          },
          "required": ["job_id", "model", "identity", "work_type", "model_version", "terminal", "price_snapshot", "decision_id"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "job.meter",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "终端计量：token 进/出/缓存命中 + 金额",
          "properties": {
            "type": { "const": "job.meter" },
            "job_id": { "type": "string" },
            "model": { "type": "string" },
            "token_in": { "type": "integer", "minimum": 0 },
            "token_out": { "type": "integer", "minimum": 0 },
            "cache_hit": { "type": "integer", "minimum": 0, "description": "输入缓存命中 token 数" },
            "usd_cash": { "type": "number", "description": "现金账（立记，不等归因）" }
          },
          "required": ["job_id", "model", "token_in", "token_out", "cache_hit", "usd_cash"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "job.handoff",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "A→B 接手及原因（F16 配额耗尽可接手，源模型不记能力失败）",
          "properties": {
            "type": { "const": "job.handoff" },
            "job_id": { "type": "string" },
            "from_model": { "type": "string" },
            "to_model": { "type": "string" },
            "reason": { "enum": ["quota", "failure", "capacity", "user", "other"] }
          },
          "required": ["job_id", "from_model", "to_model", "reason"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "job.closed",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "终态 + 总金额 + 是否返工；成功合并 = 能力账正样本（L0 直记）",
          "properties": {
            "type": { "const": "job.closed" },
            "job_id": { "type": "string" },
            "success": { "type": "boolean" },
            "rework": { "type": "boolean" },
            "usd_cash": { "type": "number" },
            "usd_economic": { "type": "number", "description": "含订阅摊销的经济账" },
            "merged_by": { "type": "string", "description": "最终合并作者模型（handoff 后是接手者）" }
          },
          "required": ["job_id", "success", "rework", "usd_cash", "usd_economic", "merged_by"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "job.override",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "用户自选模型（B 位，喂 F9）或帅追加范围（override_kind=scope，#591；scope 不喂 F9）",
          "properties": {
            "type": { "const": "job.override" },
            "job_id": { "type": "string" },
            "model": { "type": "string" },
            "identity": { "enum": ["帅", "协调者", "工人", "审官"] },
            "work_type": { "type": "string" },
            "override_kind": { "enum": ["model", "scope"], "description": "缺省=model（B 位自选）；scope=追加职责/改范围" },
            "triggered_by": { "enum": ["帅", "用户"], "description": "scope 追加的触发方" },
            "why": { "type": "string", "description": "scope 追加的一句话原因" }
          },
          "required": ["job_id", "model", "identity", "work_type"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "job.explore",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "用户尝鲜（C 位选中）。不进 P（选择不算偏好），结局照常进 Q（结果仍是能力证据）",
          "properties": {
            "type": { "const": "job.explore" },
            "job_id": { "type": "string" },
            "model": { "type": "string" },
            "identity": { "enum": ["帅", "协调者", "工人", "审官"] },
            "work_type": { "type": "string" }
          },
          "required": ["job_id", "model", "identity", "work_type"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "attr.rule",
      "allOf": [
        { "$ref": "#/definitions/base" },
        { "$ref": "#/definitions/attribution" },
        {
          "type": "object",
          "description": "L0 规则归因（close.mjs 零 LLM，每单必跑，按第一条命中即停）",
          "properties": { "type": { "const": "attr.rule" } },
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "attr.llm",
      "allOf": [
        { "$ref": "#/definitions/base" },
        { "$ref": "#/definitions/attribution" },
        {
          "type": "object",
          "description": "L1 单判官归因（换厂商；一次调用，禁止多模型投票）",
          "properties": {
            "type": { "const": "attr.llm" },
            "judge_model": { "type": "string", "description": "判官模型（判官选型本身也走点将台，工种=判断）" }
          },
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "attr.human",
      "allOf": [
        { "$ref": "#/definitions/base" },
        { "$ref": "#/definitions/attribution" },
        {
          "type": "object",
          "description": "L3 人类终裁（最高优先级）",
          "properties": { "type": { "const": "attr.human" } },
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "attr.retract",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "纠错：追加不改历史（D.3）。重放时被 retract 的归因当作没发生，净特征从零算，冷却若仍生效立即解除。",
          "properties": {
            "type": { "const": "attr.retract" },
            "target_event_id": { "type": "string", "description": "被撤事件（attr.*）的 event_id" },
            "reason": { "type": "string" }
          },
          "required": ["target_event_id", "reason"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "policy.patch",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "政策变更摘要（policy/ 层仅人类可写）",
          "properties": {
            "type": { "const": "policy.patch" },
            "summary": { "type": "string" },
            "changed_files": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["summary", "changed_files"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "sub.usage",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "套餐剩余配额快照（F16）；耗尽时写本事件并触发 job.handoff，源模型本段不记能力失败",
          "properties": {
            "type": { "const": "sub.usage" },
            "model": { "type": "string" },
            "period_start": { "type": "string" },
            "period_end": { "type": "string" },
            "included_tokens": { "type": ["integer", "null"], "description": "无限额为 null" },
            "used_tokens": { "type": ["integer", "null"] },
            "quota_left": { "type": ["integer", "null"] }
          },
          "required": ["model", "period_start", "period_end", "included_tokens", "used_tokens", "quota_left"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "incident",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "事故账（E.4，issue #443 拍板三字段）：machine 场 = 指纹 + 处置枚举，人场 = why 一句。因果顺序先探测后入账。",
          "properties": {
            "type": { "const": "incident" },
            "fingerprint": { "type": "string", "description": "错误指纹：来自实时探针的当前状态，不是对历史叙述的关键字匹配" },
            "disposition": { "enum": ["交卷收卷", "报错续命一次", "连续同指纹换人", "升级协调者", "升级用户", "挂账待补"] },
            "why": { "type": "string", "description": "一句人读说明" }
          },
          "required": ["fingerprint", "disposition", "why"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "audit.bypass",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "每日审计发现：退役模型仍被新派单等绕过事件（E.3）",
          "properties": {
            "type": { "const": "audit.bypass" },
            "detail": { "type": "string" },
            "evidence": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["detail", "evidence"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "audit.stale",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "价目探针发现偏差 >15% 连续两次 → 该模型价目标 suspect（E.2）",
          "properties": {
            "type": { "const": "audit.stale" },
            "model": { "type": "string" },
            "detail": { "type": "string" },
            "evidence": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["model", "detail", "evidence"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "session.state",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "会话态快照（#891 期一）：帅位/工人每轮末写一条，把「干到哪/下一步/卡不卡」从会话上下文落到盘上（会话一断即失是本单起因）。同一 session_id 会有多条（每轮末一条），读端按全序 (ts, machine, seq, event_id) 取最后一条当当前态。身份沿用本 schema 既有专名 identity（与 job.* 同一枚举），不另造 role——同义双名会让读端认两个键。",
          "properties": {
            "type": { "const": "session.state" },
            "session_id": { "type": "string", "description": "会话标识（同一终端会话内稳定）" },
            "identity": { "enum": ["帅", "协调者", "工人", "审官"] },
            "phase": { "enum": ["在途", "沉默", "待拍", "收尾"], "description": "在途=在干且有话说；沉默=干活中不播报；待拍=等用户拍板；收尾=交卷中" },
            "doing": { "type": "string", "description": "一句话：当前在干什么" },
            "next": { "type": "string", "description": "一句话：下一步" },
            "blocked": { "type": "boolean", "description": "是否卡住。与 phase=待拍 不等价：等审官/等配额也 blocked 而 phase 仍是在途，故不能由 phase 推导" },
            "pending_decision_id": { "type": ["string", "null"], "description": "正在等的 decision.pending 的 decision_id；不等则 null" },
            "digest": { "type": "string", "description": "状态摘要哈希 = 播报闸内容维去重键的内容部分（去重键 =（主体, digest））。event_id 含 ts/seq 每轮必变、当不了去重键，故另立本字段。推荐算法：canonicalStringify({identity, phase, doing, next, blocked, pending_decision_id}) 求 sha256 取前 16 hex——同一状态重复上报得同一 digest" },
            "repo": { "type": ["string", "null"], "description": "仓名（只写仓名，不写绝对路径：路径属脱敏面）" },
            "refs": { "type": "array", "items": { "type": "string" }, "description": "相关 issue/PR/commit 引用（如 #891、PR #900、077f48b）" }
          },
          "required": ["session_id", "identity", "phase", "doing", "next", "blocked", "pending_decision_id", "digest"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "decision.pending",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "待用户拍板（#891 期一）：一句话 + 选项 + 推荐，播报闸白名单三类之一（urgency=急 即时插播）。不变量（写入即校验）：每条 option 有非空 label；options 非空时至少两条（一个选项不叫拍板）；recommend 非 null 时必须命中某条 label——推荐指向不存在的选项会让飞书卡片的一键选择失效。options 允许空数组 = 开放问题（问用户的工具可以不给选项），此时 recommend 记 null。urgency / recommend / why 允许 null = 写口没查成（#897 实测：AskUserQuestion 与 im_ask_user 的入参里都没有 urgency 这一位）——宁记 null，不许伪造。",
          "properties": {
            "type": { "const": "decision.pending" },
            "decision_id": { "type": "string", "description": "本次拍板的标识；decision.resolved 用 target_decision_id 指回它" },
            "question": { "type": "string", "description": "一句话问题（说人话，见 plain-board skill）" },
            "options": {
              "type": "array",
              "description": "2—4 条清楚选项（全局约定）；label 是用户看见的那句，description 讲代价。空数组 = 开放问题（没有选项可点）；非空时至少两条",
              "items": {
                "type": "object",
                "properties": {
                  "label": { "type": "string", "description": "短选项名（用户看见并点的那句）" },
                  "description": { "type": ["string", "null"], "description": "一句话：这个选项的代价/后果；写口读不到就 null" }
                },
                "required": ["label"],
                "additionalProperties": true
              }
            },
            "recommend": { "type": ["string", "null"], "description": "推荐哪个（非 null 时必须等于某条 option 的 label）；开放问题或写口读不到就 null" },
            "urgency": { "enum": ["急", "缓", null], "description": "急=即时插播；缓=攒到窗末合成一条摘要；null=写口没查成（#897 实测：两种问用户的工具入参里都没有这一位）。播报闸可把 null 当缓处理，但账面记的是「没判过」，不是「判过是缓」" },
            "why": { "type": ["string", "null"], "description": "一句话：为什么推荐这个；写口读不到就 null（配 why_source 记清这句从哪读的）" }
          },
          "required": ["decision_id", "question", "options", "recommend", "urgency", "why"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "decision.resolved",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "拍板结果（#891 期一）：账本不可变，追加不改历史——不回填 decision.pending，另立本事件指回去。target 指 pending 的 decision_id 而非 event_id：同一次拍板可能被重复上报成多条 pending 事件。同一 target 若有多条（用户改主意），读端按全序取最后一条为准。",
          "properties": {
            "type": { "const": "decision.resolved" },
            "target_decision_id": { "type": "string", "description": "被拍的 decision.pending 的 decision_id" },
            "chosen": { "type": "array", "items": { "type": "string" }, "description": "选中的 option label，或用户自输答案的原文；单选也是一元数组——形状对齐唯一写口（#897 的 responses[]），不留字符串/数组两形让读端分支" },
            "by": { "enum": ["用户", "帅"], "description": "谁拍的。帅=值守态按已过消歧门的规则代拍，不是用户点的" },
            "note": { "type": "string", "description": "一句话补充（可省）" }
          },
          "required": ["target_decision_id", "chosen", "by"],
          "additionalProperties": true
        }
      ]
    },
    {
      "title": "session.milestone",
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "description": "里程碑：提交·落地·合并（#891 期一，字段形状随 W5 写口实测 PR #897）。写口 = Bash 的 PostToolUse，命令真成功才写；退出码没查成一律不写（fail-closed，不当成功）。为什么不复用 job.closed：那是能力账正样本、由收口路径独占写，它的必填 merged_by / usd_cash / usd_economic 在 git commit 落地那一刻一个都拿不到，硬凑只能填 unknown 去污染归因。故本类型的必填只留「动作完成那一刻真拿得到」的四项；git 探头没查成时 branch/commit/subject 记 null 并在 evidence 里加一条写清没查成，不留假 ✓。",
          "properties": {
            "type": { "const": "session.milestone" },
            "kind": { "enum": ["commit", "land", "pr-merge"], "description": "里程碑种类：commit=提交落地 / land=收工一条命令过了 / pr-merge=PR 合并" },
            "repo": { "type": ["string", "null"], "description": "只放末段目录名——绝对路径不进事件（与 session.state 的 repo 同义）；拿不到记 null" },
            "evidence": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "description": "成功判据的出处，一项一条可复查的证据，如 [\"exit_code=0\", \"commit:a1b2c3d\"]，探头没查成时加一条写清（如 \"git 探头没查成：not a git repository\"）。形状与 attr.* / audit.* 的 evidence 一致（字符串数组）——同名同形，读端不必按 type 分支（2026-09-04 帅位拍板：不留会漂的形状，注释不是闸）。空数组写入即拒：里程碑没有证据就不该写"
            },
            "milestone_key": { "type": "string", "description": "幂等键 = kind + 落地锚点（commit 短 sha / pr-<n> / 命令哈希）。同一动作重复触发靠它防重复计账——写入即校验：(type, milestone_key, repo) 已入账即拒，改 ts/seq 重放也拒（event_id 含 ts/seq，拦不住重放）。带 repo 是因为 land 那一支的锚点是命令哈希，同一条命令在两个仓跑出的哈希相同，不带 repo 会把第二个仓的真里程碑当重复吞掉" },
            "branch": { "type": ["string", "null"], "description": "git 探头没查成为 null" },
            "commit": { "type": ["string", "null"], "description": "短 sha；git 探头没查成为 null" },
            "subject": { "type": ["string", "null"], "description": "提交标题；git 探头没查成为 null" },
            "pr_number": { "type": ["integer", "null"] },
            "session_id": { "type": ["string", "null"], "description": "与 session.state 同义：哪个会话干的" },
            "identity": { "enum": ["帅", "协调者", "工人", "审官"], "description": "可选，与 job.* / session.state 同一枚举（不造 role 这类同义双名）。hook 侧判不出身份时整个字段别写——别写 null" },
            "refs": { "type": "array", "items": { "type": "string" }, "description": "相关 issue/PR/commit 引用（与 session.state 的 refs 同义）" }
          },
          "required": ["kind", "repo", "evidence", "milestone_key"],
          "additionalProperties": true
        }
      ]
    }
  ]
}
