#!/bin/bash
# dao-managed-hook: commit-msg
# 强制要求 feat/fix/refactor/perf 提交带 (vX.Y.Z) 版本后缀
# 并校验 semver 级别：feat → 至少 minor (+0.1.0)，fix/refactor/perf → patch 即可
# 来源：windsurf-dao/hooks/dao-commit-msg
# 对应 dao-commit.md §二 版本检查门

COMMIT_MSG_FILE="$1"
SUBJECT=$(head -n 1 "$COMMIT_MSG_FILE")

# 仅检查功能性 commit type
if echo "$SUBJECT" | grep -qE '^(feat|fix|refactor|perf)(\(.+\))?!?:'; then
  # 检查末尾是否有 (vX.Y.Z)
  if ! echo "$SUBJECT" | grep -qE '\(v[0-9]+\.[0-9]+\.[0-9]+\)[[:space:]]*$'; then
    echo ""
    echo "❌ [版本纪律] commit message 缺少版本后缀"
    echo ""
    echo "   feat/fix/refactor/perf 类型必须在 subject 末尾带版本号："
    echo "   格式：<type>(<scope>): <description> (vX.Y.Z)"
    echo "   示例：fix(auth): 修复登录状态丢失 (v1.2.3)"
    echo ""
    echo "   版本升级判据："
    echo "      feat          → +0.1.0 (minor：新功能)"
    echo "      fix/perf      → +0.0.1 (patch：bug 修复、性能优化)"
    echo "      refactor      → +0.0.1 (patch：重构，无功能变化)"
    echo "      破坏性变更(!) → +1.0.0 (major：架构重构)"
    echo ""
    echo "   步骤：bump 对应组件的版本文件 → git add → 重新 commit"
    echo "   跳过此检查：git commit --no-verify"
    echo ""
    exit 1
  fi

  # feat 提交必须至少 bump minor（patch 部分应为 0）
  if echo "$SUBJECT" | grep -qE '^feat(\(.+\))?!?:'; then
    VERSION=$(echo "$SUBJECT" | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | tail -1)
    PATCH=$(echo "$VERSION" | cut -d. -f3)
    if [ "$PATCH" != "0" ]; then
      echo ""
      echo "⚠️  [版本纪律] feat 提交应 bump minor 版本（+0.1.0），当前 ($VERSION) 看起来只 bump 了 patch"
      echo ""
      echo "   feat = 新功能 → minor bump（patch 归零）"
      echo "   示例：v1.12.44 → v1.13.0（不是 v1.12.45）"
      echo ""
      echo "   如果只是小改动，改用 fix/refactor 类型。"
      echo "   跳过此检查：git commit --no-verify"
      echo ""
      exit 1
    fi
  fi
fi

exit 0
