{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/lib/dispatch-gate-hook.mjs\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|mcp__mirasim__im_ask_user",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/host/skills/ask-gate/hooks/ask-gate.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/host/skills/tool-use-gate/hooks/tool-use-gate.mjs\"",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/lib/onboard-session-hook.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
